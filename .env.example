# Optional. Public site URL (no trailing slash) used for canonical links, social previews and the sitemap.
# Defaults to https://www.dhruvahospitals.com on every deployment; only set it if the site moves domain.
# Never set it to the vercel.app address.
NEXT_PUBLIC_SITE_URL=

# Optional: shows the newest Instagram reels on the site. Generated in the Meta App Dashboard
# (Instagram > API setup with Instagram business login > Generate token); valid for 60 days. See README.
INSTAGRAM_ACCESS_TOKEN=

# Optional: search engine ownership checks (only the content value of the meta tag). DNS verification needs neither.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
