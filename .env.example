# Public site URL (no trailing slash). Used for canonical links, social previews and the sitemap.
# On Vercel this falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.dhruvahospitals.com

# SMTP settings for appointment request emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-email@example.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM=your-sending-email@example.com
APPOINTMENT_RECIPIENT_EMAIL=dhruvahospitalkadapa@gmail.com
